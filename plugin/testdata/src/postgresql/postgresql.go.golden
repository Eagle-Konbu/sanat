package postgresql

var unformatted = `SELECT
  data ? 'email'
FROM
  users
WHERE
  id = $1` // want "SQL literal is not formatted"

var formatted = `SELECT
  data ? 'email'
FROM
  users
WHERE
  id = $1`

// MySQL syntax doesn't parse as PostgreSQL, so it is left alone.
var mysqlOnly = `select id from users limit 1, 2`
